{
  "name": "mariamecoulibaly-com",
  "version": "0.0.0",
  "private": true,
  "description": "Personal portfolio for Mariam Coulibaly",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:ui": "pnpm --filter ui dev",
    "dev:api": "cd api && go run ./cmd/api",
    "build:ui": "pnpm --filter ui build",
    "build:api": "cd api && go build -o bin/api ./cmd/api",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2"
  }
}
